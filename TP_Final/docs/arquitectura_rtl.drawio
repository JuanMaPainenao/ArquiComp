ounded=0;html=1;endArrow=block;endSize=4;endFill=1;strokeWidth=1;" parent="1" edge="1" source="c275" target="c253"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c277" value="dump_idx" style="shape=hexagon;perimeter=hexagonPerimeter2;size=6;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#999999;fontSize=9;dashed=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="1662.0" y="662.0" width="66.0" height="14.0" as="geometry"/></mxCell><mxCell id="c278" value="" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontFamily=Helvetica;noLabel=1;" parent="c277" vertex="1"><mxGeometry x="32.0" y="-1.0" width="2.0" height="2.0" as="geometry"/></mxCell><mxCell id="c279" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endSize=4;endFill=1;strokeWidth=1;" parent="1" edge="1" source="c278" target="c255"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c280" value="dump_data" style="shape=hexagon;perimeter=hexagonPerimeter2;size=6;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#999999;fontSize=9;dashed=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="1770.0" y="548.0" width="72.0" height="14.0" as="geometry"/></mxCell><mxCell id="c281" value="" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontFamily=Helvetica;noLabel=1;" parent="c280" vertex="1"><mxGeometry x="-1.0" y="6.0" width="2.0" height="2.0" as="geometry"/></mxCell><mxCell id="c282" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=0;html=1;endArrow=block;endSize=4;endFill=1;strokeWidth=1;" parent="1" edge="1" source="c254" target="c281"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c283" value="&lt;b&gt;Cómo se integra&lt;/b&gt;&lt;br&gt;Las etiquetas punteadas con el mismo nombre son la misma red. El reset del cpu es el botón OR el pedido de la Debug Unit (comando X o fin de carga). cpu_halted pasa a ser «HALT llegó a WB».&lt;br&gt;Los latches anchos se mandan partidos en palabras de 32 bits ([k] = palabra k). Los índices del mux son un ejemplo: se fijan con N_DUMP y el layout que lea du.ps1." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fffbe6;strokeColor=#b3a36b;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="260.0" y="640.0" width="640.0" height="110.0" as="geometry"/></mxCell><mxCell id="c284" value="&lt;b&gt;Clock (opcional)&lt;/b&gt;: si hace falta bajar la frecuencia, un Clocking Wizard entre clk y todo el resto; su &lt;i&gt;locked&lt;/i&gt; negado se suma al reset. Hay que recalcular br_generator (hoy 163 para 38.400 baudios a 100 MHz)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fffbe6;strokeColor=#b3a36b;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="960.0" y="640.0" width="520.0" height="80.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2 · cpu"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="cpu — Pipeline de 5 etapas" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="20.0" y="10.0" width="900.0" height="30.0" as="geometry"/></mxCell><mxCell id="c3" value="Fila 1: IF → IF/ID → ID → ID/EX. Fila 2: EX → EX/MEM → MEM → MEM/WB → WB. Fila 3: unidades de riesgos. Las etiquetas con el mismo nombre son la misma red; el sufijo dice en qué etapa está la señal (_if, _id, _ex, _mem, _wb)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="20.0" y="40.0" width="1100.0" height="40.0" as="geometr