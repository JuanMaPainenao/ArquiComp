 instr 0x00000013 · usa stall y flush&lt;br&gt;&lt;b&gt;ID/EX (192 b)&lt;/b&gt;: control (13 b: reg_write, alu_src, alu_op, mem_read, mem_write, wb_sel, branch, jump, jalr, halt), rs1_data, rs2_data, imm, pc, pc4, rs1, rs2, rd, funct3, funct7_5 · NOP = control en 0 · usa flush (stall = 0)&lt;br&gt;&lt;b&gt;EX/MEM (110 b)&lt;/b&gt;: reg_write, mem_read, mem_write, wb_sel, halt, alu_result, store_data, pc4, rd, funct3 · sin stall ni flush&lt;br&gt;&lt;b&gt;MEM/WB (105 b)&lt;/b&gt;: reg_write, wb_sel, halt, alu_result, load_data, pc4, rd · sin stall ni flush" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fffbe6;strokeColor=#b3a36b;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="170.0" y="440.0" width="880.0" height="130.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p20" name="debug_unit"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="debug_unit — FSM entre la UART y el procesador" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="20.0" y="10.0" width="900.0" height="30.0" as="geometry"/></mxCell><mxCell id="c3" value="Comandos: L carga · S paso · R corre hasta HALT · D volcado · X reset · P lee instr_mem. Controla el procesador solo con cpu_en y cpu_rst." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="20.0" y="40.0" width="1100.0" height="40.0" as="geometry"/></mxCell><mxCell id="c4" value="clk" style="shape=hexagon;perimeter=hexagonPerimeter2;size=8;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="20.0" y="120