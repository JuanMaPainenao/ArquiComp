byte_cnt[16] · after[2] (IDLE / DUMP / PRD)&lt;br&gt;imem_addr[8] · imem_wdata[32] · tx_data[8]&lt;br&gt;&lt;br&gt;&lt;b&gt;Dump:&lt;/b&gt; byte 0 = estado {7'b0, halted}; bytes 1..4·dump_words = dump_data en little-endian.&lt;br&gt;Termina cuando byte_cnt = 4·dump_words." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#bfa600;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1480" y="120" width="380" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4 · Protocolo UART y dump"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n213" value="Protocolo PC ↔ FPGA (38400 8N1) y formato del dump" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n214" value="&lt;b&gt;Comandos (PC → FPGA)&lt;/b&gt;&lt;table style='border-collapse:collapse;font-size:11px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #999;padding:3px 6px;background:#e1d5e7;'&gt;Byte&lt;/th&gt;&lt;th style='border:1px solid #999;padding:3px 6px;background:#e1d5e7;'&gt;Args&lt;/th&gt;&lt;th style='border:1px solid #999;padding:3px 6px;background:#e1d5e7;'&gt;Hace&lt;/th&gt;&lt;th style='border:1px solid #999;padding:3px 6px;background:#e1d5e7;'&gt;Responde&lt;/th&gt;&lt;th style='border:1px solid #999;padding:3px 6px;background:#e1d5e7;'&gt;du.ps1&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;'L' 0x4C&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;N_lo N_hi + 4·N bytes&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;carga N palabras desde imem[0], cpu_en=0, al final cpu_rst&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;'K'&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;L w0 w1… / file X.hex&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;'S' 0x53&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;cpu_en = 1 durante 1 ciclo&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;dump&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;Enter / s [N]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;'R' 0x52&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;cpu_en = 1 hasta halted&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;dump&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;r&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;'D' 0x44&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;nada&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;dump&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;d / v&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;'X' 0x58&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;cpu_rst (PC=0, pipeline vacío, dmem y regs a 0)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;'K'&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;x&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;'P' 0x50&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;N_lo N_hi&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;lee imem[0..N−1]&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;4·N bytes (N=0 → 'K')&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;mem [N]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;otro&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;'?'&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;raw …&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;overflow=fill;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="860" height="250" as="geometry"/></mxCell><mxCell id="n215" value="&lt;b&gt;Dump (FPGA → PC)&lt;/b&gt;: 1 byte de estado + (54 + M) palabras de 32 bits little-endian&lt;table style='border-collapse:collapse;font-size:11px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #999;padding:3px 6px;background:#e1d5e7;'&gt;Índice&lt;/th&gt;&lt;th style='border:1px solid #999;padding:3px 6px;background:#e1d5e7;'&gt;Contenido&lt;/th&gt;&lt;th style='border:1px solid #999;padding:3px 6px;background:#e1d5e7;'&gt;Fuente en top.v&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;byte 0&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;estado: bit0 = halted&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;debug_unit&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;0&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;PC (etapa IF)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;cpu.pc&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;1&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;M = palabras de dmem usadas = max_addr[7:2] + 1&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;top&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;2 .. 21&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;20 latches / riesgos (dbg_latch_sel = idx − 2)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;cpu.dbg_latch_data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;22 .. 53&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;x0 .. x31 (dbg_reg_addr = idx − 22)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;reg_file&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;54 .. 54+M−1&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;dmem palabras 0..M−1 (dbg_dmem_addr = idx − 54)&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;mem&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;overflow=fill;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="860" height="220" as="geometry"/></mxCell><mxCell id="n216" value="&lt;b&gt;Latches (dbg_latch_sel)&lt;/b&gt; — cada latch guarda pc4; pc4 = 0 → burbuja&lt;table style='border-collapse:collapse;font-size:11px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #999;padding:3px 6px;background:#e1d5e7;'&gt;sel&lt;/th&gt;&lt;th style='border:1px solid #999;padding:3px 6px;background:#e1d5e7;'&gt;Contenido&lt;/th&gt;&lt;th style='border:1px solid #999;padding:3px 6px;background:#e1d5e7;'&gt;sel&lt;/th&gt;&lt;th style='border:1px solid #999;padding:3px 6px;background:#e1d5e7;'&gt;Contenido&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;0&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;IF: instr leída de imem&lt;/td&gt;&lt;td style='border:1px solid #bbb;padding:3px 6px;'&gt;