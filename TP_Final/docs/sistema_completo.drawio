ntFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="440" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2 · cpu (pipeline)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n85" value="cpu.v — Pipeline IF · ID · EX · MEM · WB" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="34" as="geometry"/></mxCell><mxCell id="n86" value="Todos los latches y el PC avanzan sólo con en = 1 (Debug Unit). rst = burbuja. Saltos resueltos en EX (2 instrucciones descartadas). Forwarding desde EX/MEM y desde WB. Load-use = 1 ciclo de stall." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1800" height="36" as="geometry"/></mxCell><mxCell id="n87" value="&lt;b&gt;IF&lt;/b&gt;" style="text;html=1;align=center;fontSize=16;fontColor=#1f4e9c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="220" height="26" as="geometry"/></mxCell><mxCell id="n88" value="&lt;b&gt;ID&lt;/b&gt;" style="text;html=1;align=center;fontSize=16;fontColor=#1f4e9c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="86" width="270" height="26" as="geometry"/></mxCell><mxCell id="n89" value="&lt;b&gt;EX&lt;/b&gt;" style="text;html=1;align=center;fontSize=16;fontColor=#1f4e9c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="86" width="300" height="26" as="geometry"/></mxCell><mxCell id="n90" value="&lt;b&gt;MEM&lt;/b&gt;" style="text;html=1;align=center;fontSize=16;fontColor=#1f4e9c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="86" width="230" height="26" as="geometry"/