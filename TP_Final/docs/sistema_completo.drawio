<mxfile host="app.diagrams.net" type="device"><diagram id="p0" name="1 · Sistema completo"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="TP Final — Sistema completo: PC ↔ Basys 3" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="34" as="geometry"/></mxCell><mxCell id="n2" value="RISC-V (RV32I reducido) con pipeline de 5 etapas + Debug Unit por UART. Todo el diseño corre a 80 MHz (clk_sys del MMCM). La PC programa el bitstream por JTAG y después maneja el procesador por la UART con du.ps1." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1500" height="36" as="geometry"/></mxCell><mxCell id="n3" value="PC (Windows)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fillColor=none;strokeColor=#333333;fontSize=13;fontStyle=1;swimlaneFillColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="440" height="700" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;scripts/du.ps1&lt;/b&gt; — consola / debugger&lt;br&gt;&lt;font style='font-size:10px'&gt;Enter / s [N] · r · d · x · L w0 w1.. · file X.hex&lt;br&gt;mem [N] · dmem · lat · raw · help · q&lt;br&gt;Desensambla, muestra pipeline IF..WB, riesgos,&lt;br&gt;registros x0..x31 y memoria de datos usada&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="400" height="110" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;scripts/smoke_test.ps1&lt;/b&gt;&lt;br&gt;&lt;font style='font