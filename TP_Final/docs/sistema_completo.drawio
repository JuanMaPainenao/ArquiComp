id="n23" value="i_rx · B18" style="shape=hexagon;perimeter=hexagonPerimeter2;size=8;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="100" height="26" as="geometry"/></mxCell><mxCell id="n24" value="o_tx · A18" style="shape=hexagon;perimeter=hexagonPerimeter2;size=8;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="260" width="100" height="26" as="geometry"/></mxCell><mxCell id="n25" value="clk_100 · W5&lt;br&gt;100 MHz" style="shape=hexagon;perimeter=hexagonPerimeter2;size=8;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="690" width="100" height="40" as="geometry"/></mxCell><mxCell id="n26" value="i_reset · U18&lt;br&gt;(BTNC)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=8;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="790" width="100" height="40" as="geometry"/></mxCell><mxCell id="n27" value="Configuración FPGA" style="shape=hexagon;perimeter=hexagonPerimeter2;size=8;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="100" height="40" as="geometry"/></mxCell><mxCell id="n28" value="TX→RsRx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeWidth=2;strokeColor=#2e7d32;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="RsTx→RX" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeWidth=2;strokeColor=#2e7d32;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="n24" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="bitstream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="top.v" style="swimlane;startSize=24;html=1;rounded=0;fillColor=#f9f9f9;strokeColor=#999999;fontSize=12;fontStyle=1;dashed=1;swimlaneFillColor=#fcfcfc;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="1090" height="810" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;rx_uart&lt;/b&gt;&lt;br&gt;oversampling 16× · 8N1&lt;br&gt;o_dout[8] · o_rx_done" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="190" height="66" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;tx_uart&lt;/b&gt;&lt;br&gt;i_tx_start · i_data[8]&lt;br&gt;o_tx · o_tx_done" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="250" width="190" height="66" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;br_generator&lt;/b&gt;&lt;br&gt;DIV = 130&lt;br&gt;80 MHz / 130 ≈ 16 × 38400" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="360" width="190" height="66" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;clk_gen&lt;/b&gt; (MMCME2_BASE + BUFG)&lt;br&gt;VCO = 100 × 8 = 800 MHz&lt;br&gt;clk_out = 800 / 10 = &lt;b&gt;80 MHz&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;a 100 MHz WNS = −0.498 ns → se baja a 80&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="660" width="230" height="96" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;rst&lt;/b&gt; = i_reset | ~locked" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="790" width="230" height="36" as="geometry"/></mxCell><mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeWidth=2;strokeColor=#2e7d32;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="o_tx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeWidth=2;strokeColor=#2e7d32;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n33" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n39" value="clk_100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#bf9000;fontColor=#9a7400;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#bf9000;fontColor=#9a7400;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n26" target="n36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n41" value="locked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#bf9000;fontColor=#9a7400;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n35" target="n36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n42" value="br_tick" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#bf9000;fontColor=#9a7400;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="n34" target="n32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="380"/><mxPoint x="865" y="203"/></Array></mxGeometry></mxCell><mxCell id="n43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#bf9000;fontColor=#9a7400;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="n34" target="n33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="380"/><mxPoint x="865" y="303"/></Array></mxGeometry></mxCell><mxCell id="n44" value="&lt;b&gt;debug_unit&lt;/b&gt; (FSM, ver página 3)&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Comandos (1 byte + args):&lt;br&gt;&lt;b&gt;L&lt;/b&gt; N_lo N_hi bytes… → carga imem, cpu_rst, 'K'&lt;br&gt;&lt;b&gt;S&lt;/b&gt; → cpu_en 1 ciclo + dump&lt;br&gt;&lt;b&gt;R&lt;/b&gt; → cpu_en hasta halted + dump&lt;br&gt;&lt;b&gt;D&lt;/b&gt; → dump sin ejecutar&lt;br&gt;&lt;b&gt;X&lt;/b&gt; → cpu_rst, 'K'&lt;br&gt;&lt;b&gt;P&lt;/b&gt; N_lo N_hi → lee N palabras de imem&lt;br&gt;otro → '?'&lt;br&gt;&lt;br&gt;El clock nunca se toca: se pausa con &lt;b&gt;cpu_en&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1170" y="150" width="280" height="300" as="geometry"/></mxCell><mxCell id="n45" value="rx_data[8], rx_done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeWidth=2;strokeColor=#2e7d32;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n32" target="n44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n46" value="tx_start, tx_data[8]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeWidth=2;strokeColor=#2e7d32;exitX=0;exitY=0.45;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="n44" target="n33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="285"/><mxPoint x="1120" y="276"/></Array></mxGeometry></mxCell><mxCell id="n47" value="tx_done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeWidth=2;strokeColor=#2e7d32;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="n33" target="n44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="303"/><mxPoint x="1130" y="330"/></Array></mxGeometry></mxCell><mxCell id="n48" value="br_tick" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#bf9000;fontColor=#9a7400;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="n34" target="n44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n49" value="cpu_rst = rst | du.cpu_rst" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="490" width="280" height="32" as="geometry"/></mxCell><mxCell id="n50" value="du.cpu_rst" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n44" target="n49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n51" value="&lt;b&gt;cpu&lt;/b&gt; — pipeline 5 etapas (ver página 2)&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;IF → ID → EX → MEM → WB&lt;br&gt;forwarding (MEM/WB → EX) · hazard unit (load-use, saltos, HALT)&lt;br&gt;imem 256 × 32 (LUTRAM) · dmem 256 B (flip-flops)&lt;br&gt;RV32I: R, I, loads/stores b/h/w, LUI, BEQ/BNE, JAL, JALR, HALT=0x0&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1560" y="150" width="360" height="170" as="geometry"/></mxCell><mxCell id="n52" value="cpu_en" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="n44" target="n51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n53" value="halted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.33;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="n51" target="n44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n54" value="imem_we, imem_addr[8], imem_wdata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;dashPattern=1 3;strokeWidth=1.5;strokeColor=#9673a6;fontColor=#7a4d8f;exitX=1;exitY=0.38;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="n44" target="n51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n55" value="imem_rdata (lectura 'P')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;dashPattern=1 3;strokeWidth=1.5;strokeColor=#9673a6;fontColor=#7a4d8f;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n51" target="n44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n56" value="rst" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n49" target="n51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1614" y="506"/></Array></mxGeometry></mxCell><mxCell id="n57" value="&lt;b&gt;Mux del dump&lt;/b&gt; (combinacional, según dump_idx)&lt;br&gt;&lt;font style='font-size:10px'&gt;0 → PC&lt;br&gt;1 → M = palabras de dmem usadas&lt;br&gt;2..21 → latches / riesgos (dbg_latch_sel)&lt;br&gt;22..53 → x0..x31 (dbg_reg_addr)&lt;br&gt;54..54+M−1 → dmem (dbg_dmem_addr)&lt;br&gt;dump_words = 54 + M → a la Debug Unit&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1560" y="560" width="360" height="150" as="geometry"/></mxCell><mxCell id="n58" value="pc, lat_dbg_data,&lt;br&gt;reg_dbg_data, mem_dbg_data,&lt;br&gt;dmem_max_addr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;dashPattern=1 3;strokeWidth=1.5;strokeColor=#9673a6;fontColor=#7a4d8f;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n51" target="n57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n59" value="lat/reg/mem idx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;dashPattern=1 3;strokeWidth=1.5;strokeColor=#9673a6;fontColor=#7a4d8f;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n57" target="n51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n60" value="dump_idx[8]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;dashPattern=1 3;strokeWidth=1.5;strokeColor=#9673a6;fontColor=#7a4d8f;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n44" target="n57"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="605"/></Array></mxGeometry></mxCell><mxCell id="n61" value="dump_data[32], dump_words" style="edgeStyle=orthog