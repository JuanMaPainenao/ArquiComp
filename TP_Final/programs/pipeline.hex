# pipeline.hex - Programa para ver una instruccion recorrer IF-ID-EX-MEM-WB
# y cada riesgo del pipeline. Ejecutarlo con "s" (paso a paso) en du.ps1.
#
# Resultado esperado al HALT:
#   x1=0x5C x2=7 x3=12 x4=7 x5=x6=0x12345678 x7=0x12345679 x8=0x12 x9=0x78
#   x10=0x1234 x11=0 (las 2 de despues del beq se descartan) x12=0 x13=6
#   x14=106 x15=1
#   mem: [0]=0x12345678 [4]=0x0007000C [8]=6 [12]=106
#
# --- 1. Forwarding: el dato se usa en la instruccion siguiente
00500093   # 0x000  addi x1, x0, 5                  ; x1 = 5
00700113   # 0x004  addi x2, x0, 7                  ; x2 = 7
002081b3   # 0x008  add  x3, x1, x2                 ; x3 = 12  (x2 desde EX/MEM, x1 desde MEM/WB)
40118233   # 0x00C  sub  x4, x3, x1                 ; x4 = 7   (x3 desde EX/MEM)
123452b7   # 0x010  lui  x5, 0x12345                ; x5 = 0x12345000
67828293   # 0x014  addi x5, x5, 0x678              ; x5 = 0x12345678 (forwarding de lui)
# --- 2. Stores (ver la memoria de datos con "dmem")
00502023   # 0x018  sw   x5, 0(x0)                  ; mem[0..3] = 0x12345678 (dato con forwarding)
00300223   # 0x01C  sb   x3, 4(x0)                  ; mem[4]    = 0x0C
00401323   # 0x020  sh   x4, 6(x0)                  ; mem[6..7] = 0x0007
# --- 3. Load-use: 1 ciclo de stall + burbuja en ID/EX
00002303   # 0x024  lw   x6, 0(x0)                  ; x6 = 0x12345678
00130393   # 0x028  addi x7, x6, 1                  ; x7 = 0x12345679 (STALL, despues fwd desde WB)
00300403   # 0x02C  lb   x8, 3(x0)                  ; x8 = 0x12
00004483   # 0x030  lbu  x9, 0(x0)                  ; x9 = 0x78
00201503   # 0x034  lh   x10, 2(x0)                 ; x10 = 0x1234
# --- 4. Saltos: tomado (flush de IF/ID e ID/EX) y no tomado
00220663   # 0x038  beq  x4, x2, salto              ; 7 == 7 -> tomado
fff00593   # 0x03C  addi x11, x0, -1                ; se descarta (flush)
fff00593   # 0x040  addi x11, x0, -1                ; se descarta (flush)
00109063   # 0x044  bne x1, x1, salto               ; no tomado: no pierde ciclos
00300613   # 0x048  addi x12, x0, 3                 ; contador del loop
# --- 5. Loop: x13 = 3 + 2 + 1
00c686b3   # 0x04C  add x13, x13, x12
fff60613   # 0x050  addi x12, x12, -1
fe061ce3   # 0x054  bne  x12, x0, loop              ; tomado 2 veces
# --- 6. jal / jalr (subrutina)
00c000ef   # 0x058  jal  x1, func                   ; x1 = 0x5C, salta a func
00d02423   # 0x05C  sw   x13, 8(x0)                 ; mem[8] = 6 (al volver)
00000000   # 0x060  halt                            ; HALT: frena el fetch y vacia el pipeline
06468713   # 0x064  addi x14, x13, 100              ; x14 = 106
00e02623   # 0x068  sw   x14, 12(x0)                ; mem[12] = 106
003227b3   # 0x06C  slt  x15, x4, x3                ; x15 = 1 (7 < 12)
00008067   # 0x070  jalr x0, 0(x1)                  ; vuelve a 0x5C (detras viene un HALT: se descarta)
